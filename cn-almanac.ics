#!/usr/bin/env python3
# -*- coding: utf-8 -*-

from datetime import date, timedelta
from lunar_python import Solar

START_YEAR = 2026
END_YEAR = 2036
OUT = "cn-almanac.ics"


def esc(text):
    """转义 ICS 特殊字符"""
    if text is None:
        return ""

    return (
        str(text)
        .replace("\\", "\\\\")
        .replace(";", "\\;")
        .replace(",", "\\,")
        .replace("\n", "\\n")
    )


def join_items(items):
    if not items:
        return ""
    return "、".join(str(x) for x in items)


def get_day_description(solar):
    lunar = solar.getLunar()

    lines = []

    # 公历
    lines.append(f"📅 公历：{solar.toYmd()}")

    # 农历
    lines.append(
        f"🌙 农历：{lunar.getMonthInChinese()}月"
        f"{lunar.getDayInChinese()}"
    )

    # 年份、生肖
    try:
        lines.append(
            f"🐎 年份：{lunar.getYearInGanZhi()}年"
            f"（{lunar.getYearShengXiao()}年）"
        )
    except Exception:
        pass

    # 干支日
    try:
        lines.append(
            f"📅 干支日：{lunar.getDayInGanZhi()}日"
        )
    except Exception:
        pass

    # 宜
    try:
        yi = lunar.getDayYi()
        if yi:
            lines.append("✅ 宜：" + join_items(yi))
    except Exception:
        pass

    # 忌
    try:
        ji = lunar.getDayJi()
        if ji:
            lines.append("❌ 忌：" + join_items(ji))
    except Exception:
        pass

    # 冲煞
    try:
        chong = lunar.getDayChongDesc()
        sha = lunar.getDaySha()
        lines.append(f"🔴 冲煞：冲{chong}；煞{sha}")
    except Exception:
        pass

    # 神煞
    try:
        shensha = lunar.getDayShenSha()
        if shensha:
            lines.append("⭐ 神煞：" + join_items(shensha))
    except Exception:
        pass

    # 节气
    try:
        jieqi = lunar.getJieQi()
        if jieqi:
            lines.append("🌿 节气：" + str(jieqi))
    except Exception:
        pass

    # 传统节日
    try:
        festivals = lunar.getFestivals()
        if festivals:
            lines.append("🎎 节日：" + join_items(festivals))
    except Exception:
        pass

    return "\n".join(lines)


def main():

    current = date(START_YEAR, 1, 1)
    end_date = date(END_YEAR + 1, 1, 1)

    events = []

    while current < end_date:

        solar = Solar.fromYmd(
            current.year,
            current.month,
            current.day
        )

        lunar = solar.getLunar()

        # iPhone 日历标题
        summary = (
            f"农历 {lunar.getMonthInChinese()}月"
            f"{lunar.getDayInChinese()} · "
            f"{lunar.getDayInGanZhi()}日"
        )

        description = get_day_description(solar)

        next_day = current + timedelta(days=1)

        event = (
            "BEGIN:VEVENT\r\n"
            f"UID:cn-almanac-{current.isoformat()}@KrisWei9527\r\n"
            f"DTSTART;VALUE=DATE:{current.strftime('%Y%m%d')}\r\n"
            f"DTEND;VALUE=DATE:{next_day.strftime('%Y%m%d')}\r\n"
            f"SUMMARY:{esc(summary)}\r\n"
            f"DESCRIPTION:{esc(description)}\r\n"
            "END:VEVENT\r\n"
        )

        events.append(event)

        current = next_day

    with open(
        OUT,
        "w",
        encoding="utf-8",
        newline=""
    ) as f:

        f.write("BEGIN:VCALENDAR\r\n")
        f.write("VERSION:2.0\r\n")
        f.write(
            "PRODID:-//KrisWei9527//"
            "CN Chinese Almanac//CN\r\n"
        )
        f.write("CALSCALE:GREGORIAN\r\n")
        f.write("METHOD:PUBLISH\r\n")

        f.write(
            "X-WR-CALNAME:🇨🇳 黄历\r\n"
        )

        f.write(
            "X-WR-TIMEZONE:Asia/Shanghai\r\n"
        )

        f.write(
            "X-WR-CALDESC:"
            "中国黄历：农历、干支、生肖、"
            "宜忌、冲煞、神煞、节气与传统节日\r\n"
        )

        for event in events:
            f.write(event)

        f.write("END:VCALENDAR\r\n")


if __name__ == "__main__":
    main()
